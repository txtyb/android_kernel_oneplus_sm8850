# Defaults for .github/workflows/build-full-kernel.yml.
#
# The workflow's "Resolve configuration" step sources this file and then lets the
# workflow_dispatch inputs (or, on push, these values) override each entry, so
# editing this file and pushing is enough to trigger a build of another variant.
#
# Current setting: KMI 5 experiment (Linux 6.12.23 - the generation the ROM of
# this device ships).  These are the OnePlus-SM8850-Development revisions of
# July 2025, whose android/ACK_SHA pins aosp ACK android16-6.12-2025-06_r8:
#
#   soc        222aacee97  2025-07-16  -> ACK android16-6.12-2025-06_r8
#   modules    44578fd19e  2025-07-19
#   devicetrees d7b8b24abf 2025-07-19
#
# ACK generation map (kernel/common, verified from build.config.constants):
#   android16-6.12-2025-05-exp          KMI 4
#   deprecated/android16-6.12-2025-06   6.12.23  KMI 5
#   android16-6.12-2025-09              6.12.38  KMI 5
#   android16-6.12-2025-12              6.12.58  KMI 6
#   android16-6.12-2026-06              6.12.81  KMI 6

COMMON_URL=https://android.googlesource.com/kernel/common
COMMON_REF=android16-6.12-2025-06_r8
SOC_REF=222aacee97
MODULES_REF=44578fd19e
DEVICETREES_REF=d7b8b24abf
KLEAF_REF=main-kernel-2025
TARGET=canoe_perf
