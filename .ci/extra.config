# Extra kernel configuration for the OnePlus 15 (infiniti) OSS kernel.
#
# Why this file exists
# -------------------
# The GKI/ACK defconfig (arch/arm64/configs/gki_defconfig) enables CONFIG_TMPFS=y
# but never mentions TMPFS_XATTR, and fs/Kconfig declares it as:
#
#     config TMPFS_XATTR
#         bool "Tmpfs extended attributes"
#         depends on TMPFS
#         default n
#
# so it ends up 'n' in the built kernel. PixelOS/LineageOS user space -- and
# modules that put an overlay or per-file metadata on tmpfs (Mountify, some
# KernelSU module layouts, Android's own selinux xattrs on /dev) -- need the
# tmpfs xattr handlers, hence CONFIG_TMPFS_XATTR=y.
#
# How it is applied
# -----------------
# .ci/apply-config.py merges the lines below into the Qualcomm kleaf
# defconfig dict for the canoe perf variant,
#
#     vendor/oneplus/sm8850/configs/canoe_perf.bzl
#
# which kleaf (kleaf-scripts/defconfig_fragment.bzl) turns back into a defconfig
# fragment that is merged *after* gki_defconfig. The consolidate variant picks
# the same fragment up implicitly (android_build.bzl passes canoe_perf_config as
# `implicit_config_fragment` for consolidate), so one edit covers both variants.
#
# Add further options here with normal .config syntax; '=y', '=m', '="string"'
# and '# CONFIG_FOO is not set' are all understood.
CONFIG_TMPFS_XATTR=y
